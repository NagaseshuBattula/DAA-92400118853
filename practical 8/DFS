#include <iostream>
#include <vector>
using namespace std;

vector<vector<int>> graph;
vector<int> visited;

void DFS(int v)
{
    cout << v << " ";
    visited[v] = 1;

    for (int next : graph[v])
    {
        if (visited[next] == 0)
        {
            DFS(next);
        }
    }
}

int main()
{
    int n, e, u, v, start;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    graph.resize(n);
    visited.resize(n, 0);

    cout << "Enter edges:\n";
    for (int i = 0; i < e; i++)
    {
        cin >> u >> v;
        graph[u].push_back(v);
        graph[v].push_back(u);
    }

    cout << "Enter starting vertex: ";
    cin >> start;

    cout << "DFS: ";
    DFS(start);

    return 0;
}
