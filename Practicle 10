
#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main()
{
    int n, e;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter number of edges: ";
    cin >> e;

    vector<pair<int, pair<int, int>>> edges;

    cout << "Enter edges (u v weight):\n";

    for(int i = 0; i < e; i++)
    {
        int u, v, w;
        cin >> u >> v >> w;

        edges.push_back({w, {u, v}});
    }

    sort(edges.begin(), edges.end());

    vector<int> parent(n);

    for(int i = 0; i < n; i++)
        parent[i] = i;

    int totalCost = 0;
    int count = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    for(auto edge : edges)
    {
        int w = edge.first;
        int u = edge.second.first;
        int v = edge.second.second;

        int a = u;
        while(parent[a] != a)
            a = parent[a];

        int b = v;
        while(parent[b] != b)
            b = parent[b];

        if(a != b)
        {
            cout << u << " - " << v << " : " << w << endl;

            totalCost += w;
            parent[a] = b;
            count++;
        }

        if(count == n - 1)
            break;
    }

    if(count == n - 1)
        cout << "Minimum cost = " << totalCost << endl;
    else
        cout << "MST does not exist. Graph is disconnected.\n";

    return 0;
}
