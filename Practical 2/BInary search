#include <iostream>
int main()
{
    int arr[] = {1, 3, 4, 6, 7, 9};
    int num = 4;
    
    int low = 0;
    int high = 5;
    
    while (low <= high)
    {
        int mid = (low + high) / 2;
        
        if (num == arr[mid]) {
            std::cout << "The number is found " << mid << std::endl;
            return 0;
        }
        if (num > arr[mid]) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    std::cout << "the number is not found" << std::endl;
    return 0;
}
